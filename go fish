from deck import Deck
from card import Card

RANKS = {'A': 'ace', '2': 'two', '3': 'three', '4': 'four', '5': 'five',
         '6': 'six', '7': 'seven', '8': 'eight', '9': 'nine', '10': 'ten',
         'J': 'jack', 'Q': 'queen', 'K': 'king'}

class GoFish:
    def __init__(self, decksize):
        '''
        Initializes the game data for a game of Go Fish.
        decksize is a string: 'F' for full 52-card deck, 'S' for short 20-card deck.
        '''
        self.score = {1: 0, 2: 0}  
        self.deck = Deck('full') if decksize == 'F' else Deck('short')
        self.discard = Deck('empty')
        self.hand = {1: self.deck.deal(7), 2: self.deck.deal(7)}

    def getPlayerChoice(self):
        '''Prints self.hand[1] and prompts human to choose a rank.'''
        input("\nHit ENTER to take a turn... ")
        print("\nHere's your hand:")
        self.hand[1].printDeck()
        user_ranks = self.hand[1].ranksList()
        while True:
            answer = input("Which rank do you want to ask for? ")
            if answer in user_ranks:
                return answer
            print("Invalid choice. Please choose a rank from your hand.")

    def askForRank(self, playerNum):
        '''
        Asks the other player for a specific rank, transfers cards if found.
        '''
        choice = self.getPlayerChoice() if playerNum == 1 else self.hand[2].randomRank()

        if playerNum == 1:
            print(f"You ask: 'Do you have any {self.rankExpression(choice, 2)}?'")
        else:
            print(f"Computer asks: 'Do you have any {self.rankExpression(choice, 2)}?'")

        other_player = 2 if playerNum == 1 else 1
        num_found = self.hand[other_player].moveCardsOfRank(self.hand[playerNum], choice)
        return (num_found, choice)

    def printScore(self):
        '''Prints current scores.'''
        print(f"\nScore - You: {self.score[1]}, Computer: {self.score[2]}")

    def scoreMatch(self, playerNum, card_rank):
        '''
        Updates score and removes matched set of cards.
        '''
        self.hand[playerNum].removeCardsOfRank(card_rank)
        self.score[playerNum] += 1
        print(f"Player {playerNum} completed a set of {card_rank}s!")

    def scoreAllMatches(self):
        '''Checks both players' hands for any initial matches.'''
        for player in [1, 2]:
            for rank in self.hand[player].ranksList():
                if self.hand[player].checkForMatch(rank):
                    self.scoreMatch(player, rank)

    def keepPlaying(self):
        '''Returns True if game should continue.'''
        return self.deck.size() > 0 and all(self.hand[i].size() > 0 for i in [1, 2])

    def reportOutOfCards(self):
        '''Prints status if deck or hands are empty.'''
        if self.deck.size() == 0:
            print("Deck is empty.")
        if self.hand[1].size() == 0:
            print("You have no more cards.")
        if self.hand[2].size() == 0:
            print("Computer has no more cards.")

    def determineWinner(self):
        '''Returns winner string: "human", "computer", or "tie".'''
        if self.score[1] > self.score[2]:
            return "human"
        elif self.score[1] < self.score[2]:
            return "computer"
        return "tie"
    
    def gameOver(self):
        '''Prints an appropriate end-of-game message.'''
        print("\nGAME OVER!")
        self.reportOutOfCards()
        self.printScore()
        winner = self.determineWinner()
        if winner == "human":
            print("You win!")
        elif winner == "tie":
            print("Tie game!")
        else:
            print("You lose, better luck next time!")

    def sorryGoFish(self, playerNum, choice):
        '''Handles "Go Fish" draw logic.'''
        print("Sorry, go fish!")
        if playerNum == 1:
            input("\nHit ENTER to draw a card...")
        addedRank = self.hand[playerNum].addCardFrom(self.deck)
        print(f"Player {playerNum} drew a card of rank {addedRank}")
        if addedRank == choice and self.hand[playerNum].checkForMatch(choice):
            self.scoreMatch(playerNum, choice)
        return addedRank

    def completeTurnFor(self, playerNum):
        '''
        A player can keep playing until they miss or take 3 turns.
        '''
        turns = 0
        while turns < 3 and self.keepPlaying():
            success = self.playerTurn() if playerNum == 1 else self.computerTurn()
            if not success:
                break
            turns += 1

    def playerTurn(self):
        '''Handles one turn for the human player.'''
        num_found, choice = self.askForRank(1)
        if num_found == 0:
            return self.sorryGoFish(1, choice) == choice
        print(f"You got {num_found} {self.rankExpression(choice, num_found)}")
        if self.hand[1].checkForMatch(choice):
            self.scoreMatch(1, choice)
        return True

    def computerTurn(self):
        '''Handles one turn for the computer player.'''
        num_found, choice = self.askForRank(2)
        if num_found == 0:
            return self.sorryGoFish(2, choice) == choice
        print(f"Computer got {num_found} {self.rankExpression(choice, num_found)}")
        if self.hand[2].checkForMatch(choice):
            self.scoreMatch(2, choice)
        return True

    def rankExpression(self, choice, num_found):
        '''
        Returns correct plural form for card rank.
        '''
        R = RANKS[choice]
        return "sixes" if choice == '6' else R + "s" if num_found > 1 else R
